# Crannia 的环境变量。复制成 `.env` 之后填值（`.env` 不进仓库）。
#
# 只填你要用的那几个 —— 没填的通道不会被启动，没填的 provider 在界面上也切不过去。
# 键名与 `config.yaml` 里的 `${...}` 占位符一一对应。

# ── 模型 ──────────────────────────────────────────────
# 默认 provider（config.yaml 里 model.provider 的 deepseek）
DEEPSEEK_API_KEY=sk-your-key-here

# 其余都是内置 provider，切换到哪个就填哪个
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GLM_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=

# ── IM 通道 ───────────────────────────────────────────
# Telegram：找 @BotFather 申请，再把 config.yaml 的 channel.default 改成 telegram_channel
TELEGRAM_BOT_TOKEN=
# 需要代理才连得上 Telegram 时填这一条（config.yaml 的 channel.telegram.proxy
# 默认空着；也可以直接把地址写在那里）
TELEGRAM_PROXY=

# 飞书：开放平台自建应用的 App ID / App Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 钉钉：开放平台应用的 AppKey / AppSecret
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# 微信走 iLink 扫码登录，没有环境变量 —— 凭据落在 data/wechat_credentials.json

# ── 可选运行期开关 ────────────────────────────────────
# 这几个不填就用默认值；要用就把行首的 `# ` 去掉。
# 端口：默认 5000（桌面壳自己拉起后端时不用改）
# CRANNIA_API_PORT=5000
# 数据根：默认 %APPDATA%\Crannia（安装版）/ 项目根（源码版）
# CRANNIA_DATA_DIR=
# 界面语言：zh / en；不填跟随系统
# CRANNIA_INTERFACE_LANGUAGE=

# ── 可选：GitHub 集成 ─────────────────────────────────
# 不填也能用，只是 github_* 那几个工具会回一句「没配令牌，去设置页填」
CRANNIA_GITHUB_TOKEN=
